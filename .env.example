# Copy to .env and fill in. .env is gitignored. Source before every uv call:
#   set -a; source .env; set +a
# Scientific identities are pinned in each experiment manifest, not here.
# This file holds only machine- and owner-local values.

# ---- Kubernetes / MLXP reservation pods (kubernetes-remote-gpu skill) ----
KCFG=$HOME/.kube/config
NS=p-production                       # p-debug for debug reservations
PREFIX=                               # REQUIRED. e.g. prod-rsv-<owner>. Fails closed if empty.

# ---- Remote checkout and outputs (persistent volume inside the pod) ----
REMOTE_ROOT=/root/work/sunghee
REMOTE_CHECKOUT=$REMOTE_ROOT/repos/myproject
REMOTE_OUTPUT_ROOT=$REMOTE_ROOT/outputs/myproject

# ---- Local outputs (the `outputs` symlink target; gitignored) ----
OUTPUT_ROOT=$PWD/outputs

# ---- Caches off shared storage ----
TMPDIR=/tmp/$USER
UV_PROJECT_ENVIRONMENT=$PWD/.venv
UV_CACHE_DIR=/tmp/$USER/uv-cache
TRITON_CACHE_DIR=/tmp/$USER/triton
TORCH_HOME=/tmp/$USER/torch
TORCH_EXTENSIONS_DIR=/tmp/$USER/torch-ext
TORCHINDUCTOR_CACHE_DIR=/tmp/$USER/inductor
PYTHONPYCACHEPREFIX=/tmp/$USER/pycache
RUFF_CACHE_DIR=/tmp/$USER/ruff
PYTHONDONTWRITEBYTECODE=1
HF_HOME=/tmp/$USER/hf

# ---- Machine-local parent paths (commented out on purpose) ----
# DATA_ROOT=/root/work/sunghee/data

# ---- Overleaf (overleaf-git skill) ----
# OVERLEAF_GIT_TOKEN=            # set in your shell profile, NOT here; never commit a value
# OVERLEAF_GIT_SKILL_DIR=$HOME/.claude/skills/overleaf-git
